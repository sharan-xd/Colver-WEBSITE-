# ==============================================================================
# COLVER ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contact Form & Lead Notifications (Pick Option A, B, or C)
# ------------------------------------------------------------------------------

# Where you want to receive new client inquiry alerts:
CONTACT_RECIPIENT_EMAIL=contact@colver.in

# From address (must be a verified sender domain on Resend or SMTP):
CONTACT_FROM_EMAIL=inquiries@colver.in

# OPTION A: Resend API (Recommended on Vercel — https://resend.com)
# Free tier includes 3,000 emails/month
RESEND_API_KEY=re_123456789_abcdefg

# OPTION B: SMTP Configuration (Zoho Mail, Google Workspace, AWS SES, Brevo, SendGrid)
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=inquiries@colver.in
# SMTP_PASS=your-app-specific-password

# OPTION C: Webhook Dispatch (Slack or Discord incoming webhook URL)
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ------------------------------------------------------------------------------
# 2. Production Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://colver.in
