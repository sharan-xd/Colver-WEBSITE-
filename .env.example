# ==============================================================================
# Colver Platform Environment Configuration Example
# Copy this file to .env.local for local overrides. Never commit .env or secrets to VCS.
# ==============================================================================

# --- Development Server Configuration ---
# Optional: comma-separated origins permitted for cross-origin HMR (e.g. 192.168.1.100)
ALLOWED_DEV_ORIGINS=

# --- Contact & Lead Notification Channels ---
# Option A: Webhook Delivery (Slack, Discord, Zapier, Make, n8n)
CONTACT_WEBHOOK_URL=

# Option B: Transactional Email Delivery (Resend - https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=inquiries@colver.in
CONTACT_RECIPIENT_EMAIL=info@colver.in

# --- Production Deployment Domain ---
NEXT_PUBLIC_SITE_URL=https://colver.in
